{
  "name": "simpatik",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "stop": "node scripts/hentikan-dev.mjs",
    "restart": "node scripts/hentikan-dev.mjs && next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "data:contoh": "tsx scripts/buat-data-contoh.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx scripts/isi-contoh.ts",
    "akun": "node --env-file=.env --import tsx scripts/akun-cli.ts",
    "postinstall": "node scripts/salin-parser.mjs",
    "format": "prettier --write src scripts tests *.ts *.json *.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.2.0",
    "@deck.gl/layers": "^9.2.0",
    "@deck.gl/mapbox": "^9.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/plus-jakarta-sans": "^5.2.0",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.12.0",
    "next": "^16.0.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.10.1",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
